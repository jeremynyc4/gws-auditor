# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
sdist/
*.whl

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/

# Build artifacts (PyInstaller)
dist/
build/
*.spec.bak

# Project-specific outputs
cache/
reports/
agent_reports/

# Per-domain working directories (see docs/SOP_DOMAIN_SETUP.md) -- each one is
# a user's own local config, credentials, and audit output, never shared code.
/domains/

# Credentials & secrets (NEVER commit these)
credentials.json
credentials/*.json
!credentials/.gitkeep
token.json
*.pem
*.key
*.p12
config.yaml
# Matches at any depth (a plain "credentials/dwd_scopes.txt" only matched the
# repo root, not domains/<domain>/credentials/dwd_scopes.txt -- found 2026-09-07
# when that exact nested file showed up as untracked-and-not-ignored).
**/dwd_scopes.txt

# Local-only Claude Code settings; every other repo keeps only settings.json
# tracked and ignores this one.
.claude/settings.local.json

# Cache of the published instruction Docs, written by .claude/fetch-instructions.py
.claude/instructions.md

# Automation runtime files (logs, locks, per-run output)
automation/cron.log
automation/work.json
automation/last-run.json
automation/last-run.err
automation/run-claude.cmd
automation/.cron.lock
automation/runbook.fetched.md
automation/mention-watermark.json

# Stray local scratch output, not a tool-generated file
header_probe.csv

# OS
.DS_Store
Thumbs.db

# Claude Code
CHECK_PROGRESS.md
